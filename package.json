{
  "name": "diesel-core",
  "version": "3.4.0",
  "description": "Fast, minimal library for building backend APIs on Web Standards",
  "main": "index.js",
  "types": "index.d.ts",
  "files": [
    "./dist",
    "index.d.ts",
    "index.js"
  ],
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js",
      "require": "./index.js"
    },
    "./cors": {
      "types": "./dist/middlewares/cors/cors.d.ts",
      "import": "./dist/middlewares/cors/cors.js",
      "require": "./dist/middlewares/cors/cors.js"
    },
    "./security": {
      "types": "./dist/middlewares/security/security.d.ts",
      "import": "./dist/middlewares/security/security.js",
      "require": "./dist/middlewares/security/security.js"
    },
    "./logger": {
      "types": "./dist/middlewares/logger/logger.d.ts",
      "import": "./dist/middlewares/logger/logger.js",
      "require": "./dist/middlewares/logger/logger.js"
    },
    "./filesave": {
      "types": "./dist/middlewares/filesave/savefile.d.ts",
      "import": "./dist/middlewares/filesave/savefile.js",
      "require": "./dist/middlewares/filesave/savefile.js"
    },
    "./ratelimit": {
      "types": "./dist/middlewares/ratelimit/rate-limit.d.ts",
      "import": "./dist/middlewares/ratelimit/rate-limit.js",
      "require": "./dist/middlewares/ratelimit/rate-limit.js"
    },
    "./redisStore": {
      "types": "./dist/middlewares/ratelimit/implementation.d.ts",
      "import": "./dist/middlewares/ratelimit/implementation.js",
      "require": "./dist/middlewares/ratelimit/implementation.js"
    },
    "./dicedbStore": {
      "types": "./dist/middlewares/ratelimit/implementation.d.ts",
      "import": "./dist/middlewares/ratelimit/implementation.js",
      "require": "./dist/middlewares/ratelimit/implementation.js"
    },
    "./jwt": {
      "types": "./dist/middlewares/jwt/index.d.ts",
      "import": "./dist/middlewares/jwt/index.js",
      "require": "./dist/middlewares/jwt/index.js"
    },
    "./powered-by": {
      "types": "./dist/middlewares/powered-by/index.d.ts",
      "import": "./dist/middlewares/powered-by/index.js",
      "require": "./dist/middlewares/powered-by/index.js"
    },
    "./requestid": {
      "types": "./dist/middlewares/request-id/index.d.ts",
      "import": "./dist/middlewares/request-id/index.js",
      "require": "./dist/middlewares/request-id/index.js"
    },
    "./http-exception": {
      "types": "./dist/http-exception.d.ts",
      "import": "./dist/http-exception.js",
      "require": "./dist/http-exception.js"
    },
    "./node": {
      "types": "./dist/adaptor/node/main.d.ts",
      "import": "./dist/adaptor/node/main.js",
      "require": "./dist/adaptor/node/main.js"
    },
    "./bun": {
      "types": "./dist/adaptor/bun/index.d.ts",
      "import": "./dist/adaptor/bun/index.js",
      "require": "./dist/adaptor/bun/index.js"
    },
    "./deno": {
      "types": "./dist/adaptor/deno/index.d.ts",
      "import": "./dist/adaptor/deno/index.js",
      "require": "./dist/adaptor/deno/index.js"
    },
    "./cloudflare": {
      "types": "./dist/adaptor/cloudflare/index.d.ts",
      "import": "./dist/adaptor/cloudflare/index.js",
      "require": "./dist/adaptor/cloudflare/index.js"
    }
  },
  "scripts": {
    "build": "bun build.js",
    "test": "bun test"
  },
  "author": "Pradeep Kumar <exvillager@gmail.com> (https://github.com/exvillager)",
  "license": "MIT",
  "keywords": [
    "diesel",
    "web",
    "app",
    "http",
    "application",
    "framework",
    "router",
    "cloudflare",
    "workers",
    "fastly",
    "compute",
    "deno",
    "bun",
    "lambda",
    "nodejs",
    "bun",
    "bunjs"
  ],
  "devDependencies": {
    "@types/bun": "latest",
    "@types/deno": "^2.7.0",
    "@types/ejs": "^3.1.5"
  },
  "peerDependencies": {
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "peepal-router": "^0.5.1"
  }
}
